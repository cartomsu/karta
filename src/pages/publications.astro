---
import Layout from '~/layouts/PageLayout.astro'

const metadata = {
  title: 'Анализ публикаций с 2010 года',
  description: 'Интерактивный анализ публикаций кафедры картографии и геоинформатики: динамика, темы, поиск и фильтры.',
}
---

<Layout metadata={metadata}>
  <div class="pub-dashboard" data-publications-dashboard>
    <section class="pub-hero">
      <div class="pub-shell">
        <p class="pub-eyebrow"><span></span> Наука · публикационная активность</p>
        <div class="pub-hero-grid">
          <div>
            <h1>Публикационная<br />карта кафедры</h1>
            <p class="pub-lead">
              Интерактивный обзор публикаций кафедры с 2010 года: динамика, тематические направления и поиск по
              названиям.
            </p>
          </div>
          <aside>
            <strong>О методике</strong>
            <p>Темы определены по словам в названиях. 2026 год неполный и по умолчанию исключён из анализа.</p>
          </aside>
        </div>
      </div>
    </section>

    <div class="pub-shell pub-workspace">
      <aside class="pub-filters" aria-label="Фильтры публикаций">
        <div class="pub-heading-row">
          <div><span class="pub-index">01</span><h2>Срез данных</h2></div>
          <button type="button" class="pub-reset" data-reset>Сбросить</button>
        </div>

        <label class="pub-field">
          <span>Поиск</span>
          <input type="search" data-query placeholder="Название, автор или источник" />
        </label>
        <div class="pub-year-fields">
          <label class="pub-field"
            ><span>С года</span><input type="number" min="2010" max="2026" value="2010" data-start /></label
          >
          <label class="pub-field"
            ><span>По год</span><input type="number" min="2010" max="2026" value="2025" data-end /></label
          >
        </div>
        <label class="pub-field"><span>Тема</span><select data-theme><option>Все</option></select></label>
        <label class="pub-field"><span>Тип публикации</span><select data-type><option>Все</option></select></label>
        <label class="pub-field"><span>Язык названия</span><select data-language><option>Все</option></select></label>
        <div class="pub-selection"><strong data-selection-count>—</strong><span>записей в текущем срезе</span></div>
      </aside>

      <div class="pub-content">
        <div class="pub-heading-row pub-overview-heading">
          <div><span class="pub-index">02</span><h2>Обзор периода</h2></div>
          <button type="button" class="pub-download" data-download>Экспорт CSV ↓</button>
        </div>

        <div class="pub-kpis" aria-label="Ключевые показатели">
          <article class="pub-kpi pub-kpi-primary">
            <span>Публикаций</span><strong data-kpi-total>—</strong><small data-kpi-period>—</small>
          </article>
          <article class="pub-kpi">
            <span>Уникальных названий</span><strong data-kpi-unique>—</strong><small data-kpi-duplicates>—</small>
          </article>
          <article class="pub-kpi">
            <span>Пиковый год</span><strong data-kpi-peak>—</strong><small data-kpi-peak-count>—</small>
          </article>
          <article class="pub-kpi">
            <span>Ведущая тема</span><strong class="pub-kpi-text" data-kpi-theme>—</strong><small data-kpi-theme-count
              >—</small
            >
          </article>
        </div>

        <div class="pub-chart-grid">
          <article class="pub-panel pub-trend-panel">
            <header><div><span>Динамика</span><h3>Публикации по годам</h3></div><small>Количество</small></header>
            <div class="pub-canvas-wrap"><canvas data-trend role="img"></canvas></div>
          </article>
          <article class="pub-panel">
            <header><div><span>Структура</span><h3>Тематики публикаций</h3></div><small>Топ-8</small></header>
            <div class="pub-bars" data-theme-bars></div>
          </article>
        </div>

        <div class="pub-insight-grid">
          <article class="pub-panel pub-compact">
            <header><div><span>Лексика</span><h3>Частые слова</h3></div></header>
            <div class="pub-terms" data-terms></div>
          </article>
          <article class="pub-panel pub-compact">
            <header><div><span>Форматы</span><h3>Типы публикаций</h3></div></header>
            <div class="pub-types" data-types></div>
          </article>
        </div>

        <section class="pub-publications">
          <div class="pub-heading-row">
            <div><span class="pub-index">03</span><h2>Публикации</h2></div>
            <span class="pub-result-count" data-result-count aria-live="polite"></span>
          </div>
          <div class="pub-table-wrap">
            <table>
              <thead><tr><th>Год</th><th>Публикация</th><th>Тема</th><th>Тип</th></tr></thead>
              <tbody data-rows></tbody>
            </table>
          </div>
          <nav class="pub-pagination" aria-label="Навигация по публикациям">
            <button type="button" data-prev>← Назад</button><span data-page-label></span><button type="button" data-next
              >Далее →</button
            >
          </nav>
        </section>

        <p class="pub-source">
          Источник: выгрузка публикаций кафедры. Классификация выполнена по словам в названиях; результаты доступны для
          аналитического обзора и требуют экспертной проверки для библиографического использования.
        </p>
      </div>
    </div>
  </div>

  <script is:inline data-astro-rerun>
    ;(() => {
      const root = document.querySelector('[data-publications-dashboard]')
      if (!root || root.dataset.initialized === 'true') return
      root.dataset.initialized = 'true'

      const ALL = 'Все'
      const PAGE_SIZE = 25
      const nf = new Intl.NumberFormat('ru-RU')
      const state = { start: 2010, end: 2025, theme: ALL, type: ALL, language: ALL, query: '', page: 1 }
      const stopWords = new Set([
        'анализ',
        'данных',
        'данные',
        'данным',
        'исследование',
        'исследования',
        'оценка',
        'оценки',
        'состояния',
        'метод',
        'методы',
        'основе',
        'примере',
        'использование',
        'применение',
        'изучение',
        'the',
        'and',
        'for',
        'with',
        'from',
        'study',
        'analysis',
        'based',
        'data',
        'using',
        'case',
        'russia',
      ])

      const el = (selector) => root.querySelector(selector)
      const escapeHtml = (value) =>
        String(value ?? '').replace(
          /[&<>"']/g,
          (character) =>
            ({
              '&': '&amp;',
              '<': '&lt;',
              '>': '&gt;',
              '"': '&quot;',
              "'": '&#39;',
            })[character]
        )
      const unique = (values) => Array.from(new Set(values)).sort((a, b) => a.localeCompare(b, 'ru'))

      fetch('/data/publications.json')
        .then((response) => {
          if (!response.ok) throw new Error('Не удалось загрузить данные')
          return response.json()
        })
        .then(({ records }) => initialize(records))
        .catch(() => {
          el('[data-selection-count]').textContent = 'Ошибка'
          el('[data-rows]').innerHTML =
            '<tr><td colspan="4" class="pub-empty">Не удалось загрузить данные публикаций.</td></tr>'
        })

      function initialize(records) {
        fillSelect('[data-theme]', unique(records.map((record) => record.theme)))
        fillSelect('[data-type]', unique(records.map((record) => record.type)))
        fillSelect('[data-language]', unique(records.map((record) => record.language)))

        const controls = [
          '[data-query]',
          '[data-start]',
          '[data-end]',
          '[data-theme]',
          '[data-type]',
          '[data-language]',
        ]
        controls.forEach((selector) => {
          const control = el(selector)
          control.addEventListener(selector === '[data-query]' ? 'input' : 'change', () => {
            state.query = el('[data-query]').value
            state.start = Math.max(2010, Number(el('[data-start]').value))
            state.end = Math.min(2026, Number(el('[data-end]').value))
            if (state.start > state.end) state.end = state.start
            el('[data-end]').value = String(state.end)
            state.theme = el('[data-theme]').value
            state.type = el('[data-type]').value
            state.language = el('[data-language]').value
            state.page = 1
            render()
          })
        })

        el('[data-reset]').addEventListener('click', () => {
          Object.assign(state, { start: 2010, end: 2025, theme: ALL, type: ALL, language: ALL, query: '', page: 1 })
          el('[data-start]').value = '2010'
          el('[data-end]').value = '2025'
          el('[data-query]').value = ''
          el('[data-theme]').value = ALL
          el('[data-type]').value = ALL
          el('[data-language]').value = ALL
          render()
        })
        el('[data-prev]').addEventListener('click', () => {
          state.page -= 1
          render()
          scrollToTable()
        })
        el('[data-next]').addEventListener('click', () => {
          state.page += 1
          render()
          scrollToTable()
        })
        el('[data-download]').addEventListener('click', downloadCsv)
        window.addEventListener('resize', () => drawTrend(yearSeries(filteredRecords())))
        render()

        function fillSelect(selector, values) {
          const select = el(selector)
          values.forEach((value) => select.add(new Option(value, value)))
        }

        function filteredRecords() {
          const needle = state.query.trim().toLocaleLowerCase('ru-RU')
          return records.filter((record) => {
            if (record.year < state.start || record.year > state.end) return false
            if (state.theme !== ALL && record.theme !== state.theme) return false
            if (state.type !== ALL && record.type !== state.type) return false
            if (state.language !== ALL && record.language !== state.language) return false
            return (
              !needle ||
              `${record.title} ${record.authors} ${record.source}`.toLocaleLowerCase('ru-RU').includes(needle)
            )
          })
        }

        function ranking(list, key) {
          const counts = new Map()
          list.forEach((record) => counts.set(record[key], (counts.get(record[key]) ?? 0) + 1))
          return Array.from(counts, ([label, value]) => ({ label, value })).sort((a, b) => b.value - a.value)
        }

        function yearSeries(list) {
          const counts = new Map()
          list.forEach((record) => counts.set(record.year, (counts.get(record.year) ?? 0) + 1))
          return Array.from({ length: state.end - state.start + 1 }, (_, index) => {
            const year = state.start + index
            return { label: String(year), value: counts.get(year) ?? 0 }
          })
        }

        function frequentTerms(list) {
          const counts = new Map()
          list.forEach((record) => {
            const words = new Set(
              record.title
                .toLocaleLowerCase('ru-RU')
                .replaceAll('ё', 'е')
                .match(/[a-zа-я]{4,}/g) ?? []
            )
            words.forEach((word) => {
              if (!stopWords.has(word)) counts.set(word, (counts.get(word) ?? 0) + 1)
            })
          })
          return Array.from(counts, ([word, count]) => ({ word, count }))
            .sort((a, b) => b.count - a.count)
            .slice(0, 12)
        }

        function render() {
          const list = filteredRecords()
          const years = yearSeries(list)
          const themes = ranking(list, 'theme')
          const types = ranking(list, 'type')
          const peak = years.reduce((best, point) => (!best || point.value > best.value ? point : best), null)
          const uniqueTitles = new Set(list.map((record) => record.title)).size

          el('[data-selection-count]').textContent = nf.format(list.length)
          el('[data-kpi-total]').textContent = nf.format(list.length)
          el('[data-kpi-period]').textContent = `${state.start}–${state.end}`
          el('[data-kpi-unique]').textContent = nf.format(uniqueTitles)
          el('[data-kpi-duplicates]').textContent = `${nf.format(list.length - uniqueTitles)} повторов`
          el('[data-kpi-peak]').textContent = peak?.label ?? '—'
          el('[data-kpi-peak-count]').textContent = peak ? `${nf.format(peak.value)} публикаций` : 'Нет данных'
          el('[data-kpi-theme]').textContent = themes[0]?.label ?? '—'
          el('[data-kpi-theme-count]').textContent = themes[0]
            ? `${nf.format(themes[0].value)} публикаций`
            : 'Нет данных'

          drawTrend(years)
          renderThemeBars(themes)
          renderTerms(frequentTerms(list))
          renderTypes(types)
          renderTable(list)
        }

        function renderThemeBars(items) {
          const max = items[0]?.value ?? 1
          const container = el('[data-theme-bars]')
          container.innerHTML =
            items
              .slice(0, 8)
              .map(
                (item, index) => `
            <button type="button" class="pub-bar-row" data-value="${escapeHtml(item.label)}">
              <span class="pub-bar-rank">${String(index + 1).padStart(2, '0')}</span>
              <span class="pub-bar-content"><span class="pub-bar-label">${escapeHtml(item.label)}</span><span class="pub-bar-track"><i style="width:${(item.value / max) * 100}%"></i></span></span>
              <strong>${nf.format(item.value)}</strong>
            </button>`
              )
              .join('') || '<p class="pub-empty">Нет данных для выбранного среза.</p>'
          container
            .querySelectorAll('button')
            .forEach((button) => button.addEventListener('click', () => setFilter('theme', button.dataset.value)))
        }

        function renderTerms(items) {
          el('[data-terms]').innerHTML = items
            .map((item) => `<span>${escapeHtml(item.word)}<sup>${item.count}</sup></span>`)
            .join('')
        }

        function renderTypes(items) {
          const container = el('[data-types]')
          container.innerHTML = items
            .slice(0, 5)
            .map(
              (item) =>
                `<button type="button" data-value="${escapeHtml(item.label)}"><span>${escapeHtml(item.label)}</span><strong>${nf.format(item.value)}</strong></button>`
            )
            .join('')
          container
            .querySelectorAll('button')
            .forEach((button) => button.addEventListener('click', () => setFilter('type', button.dataset.value)))
        }

        function renderTable(list) {
          const pages = Math.max(1, Math.ceil(list.length / PAGE_SIZE))
          state.page = Math.min(state.page, pages)
          const visible = list
            .slice()
            .sort((a, b) => b.year - a.year || a.title.localeCompare(b.title, 'ru'))
            .slice((state.page - 1) * PAGE_SIZE, state.page * PAGE_SIZE)
          el('[data-result-count]').textContent = `${nf.format(list.length)} результатов`
          const body = el('[data-rows]')
          body.innerHTML =
            visible
              .map(
                (record) => `<tr>
            <td class="pub-year">${record.year}</td>
            <td><strong>${escapeHtml(record.title)}</strong><span>${escapeHtml(record.authors)}</span><small>${escapeHtml(record.source)}</small></td>
            <td><button type="button" class="pub-theme-tag" data-value="${escapeHtml(record.theme)}">${escapeHtml(record.theme)}</button>${record.duplicate ? '<em>повтор</em>' : ''}</td>
            <td>${escapeHtml(record.type)}</td>
          </tr>`
              )
              .join('') || '<tr><td colspan="4" class="pub-empty">По заданным условиям публикаций не найдено.</td></tr>'
          body
            .querySelectorAll('.pub-theme-tag')
            .forEach((button) => button.addEventListener('click', () => setFilter('theme', button.dataset.value)))
          el('[data-page-label]').textContent = `Страница ${state.page} из ${pages}`
          el('[data-prev]').disabled = state.page === 1
          el('[data-next]').disabled = state.page === pages
        }

        function setFilter(key, value) {
          state[key] = value
          state.page = 1
          el(`[data-${key}]`).value = value
          render()
        }

        function drawTrend(points) {
          const canvas = el('[data-trend]')
          const width = Math.max(320, canvas.parentElement.clientWidth - 24)
          const height = width < 520 ? 240 : 310
          const ratio = window.devicePixelRatio || 1
          canvas.width = width * ratio
          canvas.height = height * ratio
          canvas.style.width = `${width}px`
          canvas.style.height = `${height}px`
          const context = canvas.getContext('2d')
          context.scale(ratio, ratio)
          context.clearRect(0, 0, width, height)
          const padding = { top: 22, right: 18, bottom: 38, left: 42 }
          const chartWidth = width - padding.left - padding.right
          const chartHeight = height - padding.top - padding.bottom
          const maximum = Math.max(1, ...points.map((point) => point.value))
          const ceiling = Math.ceil(maximum / 50) * 50 || 50
          const dark = document.documentElement.classList.contains('dark')
          context.font = '12px Inter, Arial'
          context.strokeStyle = dark ? '#334155' : '#dce6ea'
          context.fillStyle = dark ? '#94a3b8' : '#718096'
          for (let index = 0; index <= 5; index += 1) {
            const y = padding.top + (chartHeight * index) / 5
            context.beginPath()
            context.moveTo(padding.left, y)
            context.lineTo(width - padding.right, y)
            context.stroke()
            context.fillText(String(Math.round(ceiling * (1 - index / 5))), 4, y + 4)
          }
          const step = points.length > 1 ? chartWidth / (points.length - 1) : chartWidth
          const coordinates = points.map((point, index) => ({
            x: padding.left + index * step,
            y: padding.top + chartHeight - (point.value / ceiling) * chartHeight,
          }))
          const gradient = context.createLinearGradient(0, padding.top, 0, padding.top + chartHeight)
          gradient.addColorStop(0, 'rgba(37, 99, 235, .25)')
          gradient.addColorStop(1, 'rgba(37, 99, 235, 0)')
          context.beginPath()
          coordinates.forEach((point, index) =>
            index ? context.lineTo(point.x, point.y) : context.moveTo(point.x, point.y)
          )
          context.lineTo(coordinates.at(-1).x, padding.top + chartHeight)
          context.lineTo(coordinates[0].x, padding.top + chartHeight)
          context.closePath()
          context.fillStyle = gradient
          context.fill()
          context.beginPath()
          coordinates.forEach((point, index) =>
            index ? context.lineTo(point.x, point.y) : context.moveTo(point.x, point.y)
          )
          context.strokeStyle = '#2563eb'
          context.lineWidth = 3
          context.lineJoin = 'round'
          context.stroke()
          const every = Math.max(1, Math.ceil(points.length / (width < 520 ? 6 : 10)))
          context.textAlign = 'center'
          context.fillStyle = dark ? '#94a3b8' : '#718096'
          points.forEach((point, index) => {
            if (index % every === 0 || index === points.length - 1)
              context.fillText(point.label, coordinates[index].x, height - 13)
          })
          context.textAlign = 'left'
          canvas.setAttribute('aria-label', `Динамика публикаций с ${state.start} по ${state.end} год`)
        }

        function downloadCsv() {
          const header = ['Год', 'Тип', 'Авторы', 'Название', 'Источник', 'Тема', 'Язык']
          const quote = (value) => `"${String(value ?? '').replaceAll('"', '""')}"`
          const rows = filteredRecords().map((record) => [
            record.year,
            record.type,
            record.authors,
            record.title,
            record.source,
            record.theme,
            record.language,
          ])
          const csv = `\uFEFF${[header, ...rows].map((row) => row.map(quote).join(';')).join('\r\n')}`
          const url = URL.createObjectURL(new Blob([csv], { type: 'text/csv;charset=utf-8' }))
          const link = document.createElement('a')
          link.href = url
          link.download = `publikacii_${state.start}-${state.end}.csv`
          link.click()
          URL.revokeObjectURL(url)
        }

        function scrollToTable() {
          el('.pub-publications').scrollIntoView({ behavior: 'smooth', block: 'start' })
        }
      }
    })()
  </script>
</Layout>

<style is:global>
  .pub-dashboard {
    --pub-bg: #f5f7fa;
    --pub-card: #fff;
    --pub-ink: #172033;
    --pub-muted: #667085;
    --pub-line: #dfe5ed;
    --pub-blue: #2563eb;
    --pub-blue-dark: #163c91;
    --pub-blue-soft: #dbeafe;
    color: var(--pub-ink);
    background: var(--pub-bg);
    min-height: 100vh;
  }
  .dark .pub-dashboard {
    --pub-bg: #0b1220;
    --pub-card: #111b2e;
    --pub-ink: #e5edf8;
    --pub-muted: #94a3b8;
    --pub-line: #26344a;
    --pub-blue-soft: #172554;
  }
  .pub-dashboard * {
    box-sizing: border-box;
  }
  .pub-shell {
    width: min(1480px, calc(100% - 3rem));
    margin-inline: auto;
  }
  .pub-hero {
    position: relative;
    overflow: hidden;
    color: white;
    background:
      radial-gradient(circle at 86% 28%, rgba(96, 165, 250, 0.2) 0 1px, transparent 2px) 0 0/22px 22px,
      linear-gradient(120deg, #0b2142, #163c70 68%, #17537e);
    border-bottom: 5px solid #3b82f6;
  }
  .pub-hero::after {
    content: '';
    position: absolute;
    width: 520px;
    height: 520px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 50%;
    right: -140px;
    top: -300px;
    box-shadow:
      0 0 0 70px rgba(255, 255, 255, 0.025),
      0 0 0 140px rgba(255, 255, 255, 0.018);
  }
  .pub-hero .pub-shell {
    position: relative;
    z-index: 1;
    padding-block: 56px 64px;
  }
  .pub-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin: 0;
    color: #bfdbfe;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }
  .pub-eyebrow span {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: #60a5fa;
    box-shadow: 0 0 0 5px rgba(96, 165, 250, 0.15);
  }
  .pub-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 340px;
    gap: 5rem;
    align-items: end;
    margin-top: 2.1rem;
  }
  .pub-hero h1 {
    margin: 0;
    color: white;
    font-size: clamp(3rem, 6vw, 5rem);
    line-height: 0.94;
    letter-spacing: -0.055em;
  }
  .pub-lead {
    max-width: 740px;
    margin: 1.5rem 0 0;
    color: #cbdcf0;
    font-size: 1.05rem;
    line-height: 1.65;
  }
  .pub-hero aside {
    border-top: 1px solid rgba(255, 255, 255, 0.32);
    padding-top: 1rem;
  }
  .pub-hero aside strong {
    color: #93c5fd;
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
